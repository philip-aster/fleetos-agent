    let spiffe = SpiffeId::new("fleet.test.internal", "tenant-1", IdKind::Sa, "web");
    let role = WorkloadRole::try_from("primary").unwrap();
    assert_eq!(fp, IdentityFingerprint::of(&spiffe, Some(&role)));

