[package]
name = "fleetos-agent"
version = "0.1.0"
edition = "2024"
license = "Apache-2.0"
authors = ["Philip Aster and the FleetOS Contributors"]
description = "High-priviledge Node Agent running on every FleetOS Worker Node"

[features]
default = []
# Production build: insecure join mode is warned as residual-risk and
# (from Batch 9) compiled out entirely. Mirrors fleetos-control's R-1 fence.
production = []
# Dev feature: strictly for integration tests. Gated by `fleetos_dev` cfg.
dev = ["fleetos-core/dev"]

[dependencies]
# --- FleetOS crates ---
fleetos-core = { path = "../fleetos-core", features = ["production"] }
fleetos-ebpf-common = { path = "../fleetos-ebpf/fleetos-ebpf-common" }
fleetos-policy-compiler = { path = "../fleetos-policy-compiler" }

# --- eBPF userspace ---
aya = "0.14.0"
bytemuck = { version = "1.25.2", default-features = false }

# --- gRPC / async ---
async-stream = "0.3.6"
futures = "0.3.34"
prost = "0.14.4"
prost-types = "0.14.4"
tokio = { version = "1.53.1", features = ["full"] }
tokio-stream = { version = "0.1.19", features = ["net"] }
tokio-util = { version = "0.7.19", features = ["io"] }
tonic = { version = "0.14.6", features = ["tls-ring"] }
tonic-prost = "0.14.6"

# --- Storage ---
fjall = "3.1.10"

# --- Serialization ---
postcard = { version = "1.1.3", features = ["use-std"] }
serde = { version = "1.0.229", features = ["derive"] }
serde_json = "1.0.151"
toml = "1.1.6"

# --- Crypto / identity ---
base64 = "0.23.1"
blake3 = "1.8.7"
chacha20poly1305 = "0.11.0"
hex = "0.4.3"
rand = "0.10.3"
rcgen = "0.14.10"
zeroize = { version = "1.9.0", features = ["derive"] }

# --- TLS ---
rustls = { version = "0.23.45", features = ["ring"] }
tokio-rustls = "0.26.5"
rustls-pemfile = "2.2.0"

# --- Error handling / logging ---
thiserror = "2.0.20"
tracing = "0.1.44"
tracing-subscriber = { version = "0.3.23", features = ["env-filter"] }

# --- CLI ---
clap = { version = "4.6.7", features = ["derive"] }

# --- Concurrency ---
dashmap = "6.2.1"
parking_lot = "0.12.5"

# --- Time ---
time = "0.3.55"

# --- FFI bindings ---
libc = "0.2.189"

# --- Runtime Clients ---
containerd-client = "0.9.0"
cloud-hypervisor-client = "0.6.0"

# --- Observability ---
opentelemetry = "0.33"
opentelemetry_sdk = { version = "0.33", features = ["rt-tokio"] }
opentelemetry-otlp = { version = "0.33", features = ["grpc-tonic", "logs"] }

[dev-dependencies]
hex = "0.4.3"
tempfile = "3.27.0"

[lints.rust]
# Allow the `fleetos_dev` cfg flag without compiler warnings.
unexpected_cfgs = { level = "warn", check-cfg = ['cfg(fleetos_dev)'] }
</file>

