    let fp = workload_fingerprint("fleet.test.internal", "tenant-1", "web", "primary")
        .expect("fingerprint must compute");
    // 7.6.3: must NOT be the zero placeholder.
    assert_ne!(fp, IdentityFingerprint([0; 16]));
