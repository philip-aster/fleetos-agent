#[test]
fn unknown_quote_type_rejected() {
    let server = make_server();
    let (mut guest, handle) = spawn_agent_handshake(Arc::clone(&server));
    let _challenge = read_challenge(&mut guest);
    guest.write_msg(&VsockAttestationProof {
