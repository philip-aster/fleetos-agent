    let fp2 = workload_fingerprint("fleet.test.internal", "tenant-1", "web", "primary").unwrap();
    assert_eq!(fp, fp2);
    let fp_replica =
        workload_fingerprint("fleet.test.internal", "tenant-1", "web", "replica").unwrap();
    assert_ne!(fp, fp_replica);
}

